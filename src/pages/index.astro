---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import Card from "../components/Card.astro";
import { site } from "../site.config.ts";

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const stories = (await getCollection("community", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title={site.name}
  description={site.tagline}
  path="/"
  type="website"
>
  <section class="hero">
    <div class="wrap hero-inner">
      <p class="hero-kicker">{site.place}, Thailand</p>
      <h1>{site.heroHeadline ?? `Live and work remotely in ${site.place}.`}</h1>
      <p class="hero-sub">{site.heroSubheading}</p>
      <div class="hero-actions">
        <a href="/blog" class="btn">Read the guides</a>
        <a href="/community-submit/" class="btn btn--ghost">Share your story</a>
      </div>
    </div>
    <div class="hero-glow" aria-hidden="true"></div>
  </section>

  <section class="wrap home-section">
    <div class="section-head">
      <h2>Latest guides</h2>
      <a href="/blog" class="section-link">All guides</a>
    </div>
    <div class="post-list">
      {posts.length === 0 ? (
        <p class="empty">
          No guides published yet. Add your first one in
          <code>src/content/posts/</code>.
        </p>
      ) : (
        posts.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            slug={post.id}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
          />
        ))
      )}
    </div>
  </section>

  <section class="community-teaser">
    <div class="wrap community-inner">
      <h2>This is a community, not just a guide.</h2>
      <p>
        Living in {site.place} or just passing through? Share your
        story — how you found your flat, your favourite café to work
        from, what surprised you. Add a few photos and we'll turn it
        into a post other nomads will actually read.
      </p>
      <a href="/community-submit/" class="btn">Share your story</a>
    </div>
  </section>

  {stories.length > 0 && (
    <section class="wrap home-section latest-stories">
      <div class="section-head section-head--spaced">
        <h2>Latest community stories</h2>
        <a href="/community/" class="section-link">All stories</a>
      </div>
      <ul class="card-grid">
        {stories.map((story) => (
          <li>
            <Card
              href={`/community/${story.id}/`}
              title={story.data.title}
              description={story.data.description}
              tag={story.data.tags[0]}
              byline={`By ${story.data.author}`}
              image={story.data.image}
              cta="Read story"
            />
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>

<style>
  /* Coral: two-column hero, title left and lede + actions right. */
  .hero {
    position: relative;
  }
  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    grid-template-areas:
      "kicker kicker"
      "title  sub"
      "title  actions";
    align-items: end;
    column-gap: clamp(2rem, 6vw, 5rem);
    padding-top: clamp(3.5rem, 9vw, 7rem);
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }
  .hero-kicker {
    grid-area: kicker;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-label);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    color: var(--ink-soft);
    margin: 0 0 1.4rem;
  }
  .hero-kicker::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
  .hero h1 {
    grid-area: title;
    align-self: end;
    font-size: clamp(2.5rem, 5vw + 0.5rem, 4.5rem);
    letter-spacing: -0.035em;
    margin: 0;
    max-width: 12ch;
  }
  .hero-sub {
    grid-area: sub;
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem);
    color: var(--ink-soft);
    max-width: 46ch;
    margin: 0 0 1.5rem;
  }
  .hero-actions {
    grid-area: actions;
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    align-self: end;
    padding-bottom: 0.5rem;
  }
  .hero-glow {
    display: none;
  }
  @media (max-width: 800px) {
    .hero-inner {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "kicker" "title" "sub" "actions";
    }
    .hero h1 {
      margin-bottom: 1rem;
    }
  }

  .home-section {
    padding-top: var(--space-section);
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .section-head h2 {
    margin: 0;
  }
  .section-head--spaced {
    margin-bottom: 1.5rem;
  }
  .section-link {
    font-weight: 500;
    white-space: nowrap;
  }
  .post-list {
    margin-top: 1rem;
  }
  .empty {
    padding: 2rem 0;
    color: var(--ink-soft);
  }
  .empty code {
    background: var(--paper-raised);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
  }

  /* Coral: a refined card instead of a colour flood. */
  .community-teaser {
    margin-top: var(--space-section);
    padding-inline: clamp(1.1rem, 4vw, 2.5rem);
  }
  .community-inner {
    max-width: 69rem;
    padding: clamp(2rem, 5vw, 3.5rem);
    background: var(--paper-raised);
    border: 1px solid var(--mist);
    border-radius: calc(var(--radius) + 4px);
    box-shadow: var(--shadow);
  }
  .community-teaser h2 {
    max-width: 20ch;
  }
  .community-teaser p {
    color: var(--ink-soft);
    max-width: 58ch;
    font-size: 1.05rem;
    margin-bottom: 1.6rem;
  }
</style>
