---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import Card from "../components/Card.astro";
import { site } from "../site.config.ts";

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const stories = (await getCollection("community", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title={site.name}
  description={site.tagline}
  path="/"
  type="website"
>
  <section class="hero">
    <div class="wrap hero-inner">
      <p class="hero-kicker">{site.place}, Thailand</p>
      <h1>{site.heroHeadline ?? `Live and work remotely in ${site.place}.`}</h1>
      <p class="hero-sub">{site.heroSubheading}</p>
      <div class="hero-actions">
        <a href="/blog" class="btn">Read the guides</a>
        <a href="/community-submit/" class="btn btn--ghost">Share your story</a>
      </div>
    </div>
    <div class="hero-glow" aria-hidden="true"></div>
  </section>

  <section class="wrap home-section">
    <div class="section-head">
      <h2>Latest guides</h2>
      <a href="/blog" class="section-link">All guides</a>
    </div>
    <div class="post-list">
      {posts.length === 0 ? (
        <p class="empty">
          No guides published yet. Add your first one in
          <code>src/content/posts/</code>.
        </p>
      ) : (
        posts.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            slug={post.id}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
          />
        ))
      )}
    </div>
  </section>

  <section class="community-teaser">
    <div class="wrap community-inner">
      <h2>This is a community, not just a guide.</h2>
      <p>
        Living in {site.place} or just passing through? Share your
        story — how you found your flat, your favourite café to work
        from, what surprised you. Add a few photos and we'll turn it
        into a post other nomads will actually read.
      </p>
      <a href="/community-submit/" class="btn">Share your story</a>
    </div>
  </section>

  {stories.length > 0 && (
    <section class="wrap home-section latest-stories">
      <div class="section-head section-head--spaced">
        <h2>Latest community stories</h2>
        <a href="/community/" class="section-link">All stories</a>
      </div>
      <ul class="card-grid">
        {stories.map((story) => (
          <li>
            <Card
              href={`/community/${story.id}/`}
              title={story.data.title}
              description={story.data.description}
              tag={story.data.tags[0]}
              byline={`By ${story.data.author}`}
              image={story.data.image}
              cta="Read story"
            />
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>

<style>
  /* Bloom: a centred hero sitting on one soft warm bloom. */
  .hero {
    position: relative;
    overflow: hidden;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    padding-top: clamp(4rem, 11vw, 8.5rem);
    padding-bottom: clamp(3rem, 8vw, 6rem);
    max-width: 56rem;
    text-align: center;
  }
  .hero-kicker {
    font-family: var(--font-label);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand);
    margin: 0 0 1.2rem;
  }
  .hero h1 {
    font-size: clamp(3rem, 6vw + 1rem, 5.75rem);
    letter-spacing: -0.03em;
    margin: 0 auto 1rem;
    max-width: 14ch;
  }
  .hero-sub {
    font-size: clamp(1.1rem, 1rem + 0.5vw, 1.3rem);
    color: var(--ink-soft);
    max-width: 54ch;
    margin: 0 auto 2rem;
  }
  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 0.8rem;
    flex-wrap: wrap;
  }
  .hero-glow {
    position: absolute;
    top: -20%;
    left: 50%;
    width: 80vw;
    height: 80vw;
    max-width: 900px;
    max-height: 900px;
    transform: translateX(-50%);
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--accent) 22%, transparent),
      color-mix(in srgb, var(--brand) 6%, transparent) 40%,
      transparent 66%
    );
    pointer-events: none;
    z-index: 0;
  }

  .home-section {
    padding-top: var(--space-section);
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .section-head h2 {
    margin: 0;
  }
  .section-head--spaced {
    margin-bottom: 1.5rem;
  }
  .section-link {
    font-weight: 600;
    white-space: nowrap;
  }
  .post-list {
    margin-top: 1rem;
  }
  .empty {
    padding: 2rem 0;
    color: var(--ink-soft);
  }
  .empty code {
    background: var(--paper-raised);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
  }

  /* Bloom: an elevated, centred panel instead of a colour flood. */
  .community-teaser {
    margin-top: var(--space-section);
    padding-inline: clamp(1.1rem, 4vw, 2.5rem);
  }
  .community-inner {
    position: relative;
    overflow: hidden;
    max-width: 62rem;
    padding: clamp(3rem, 7vw, 5rem) clamp(1.5rem, 5vw, 4rem);
    text-align: center;
    background:
      radial-gradient(
        ellipse at 50% 120%,
        color-mix(in srgb, var(--accent) 20%, transparent),
        transparent 60%
      ),
      var(--paper-2);
    border-radius: calc(var(--radius) + 8px);
  }
  .community-teaser h2 {
    max-width: 20ch;
    margin-inline: auto;
  }
  .community-teaser p {
    color: var(--ink-soft);
    max-width: 56ch;
    font-size: 1.1rem;
    margin: 0 auto 1.8rem;
  }
</style>
