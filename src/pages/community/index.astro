---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../../components/Card.astro";
import { site } from "../../site.config.ts";

const stories = (
  await getCollection("community", ({ data }) => !data.draft)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Tags actually used by published stories, most used first.
const tagCounts = new Map<string, number>();
for (const story of stories) {
  for (const tag of new Set(story.data.tags)) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const tags = [...tagCounts.keys()].sort(
  (a, b) => tagCounts.get(b)! - tagCounts.get(a)! || a.localeCompare(b)
);

const description = `Real stories from people living and working remotely in ${site.place}: food, coworking, day trips and life as a nomad. Share yours.`;
---

<BaseLayout title="Community" description={description} path="/community">
  <div class="wrap">
    <div class="thanks" role="status" data-thanks hidden>
      <p>
        Thank you for your submission. Your story will appear here shortly,
        once it has been checked by a human.
      </p>
      <button type="button" class="thanks-close" aria-label="Dismiss" data-thanks-close>
        <span aria-hidden="true">×</span>
      </button>
    </div>
  </div>

  <div class="wrap page-head">
    <h1>Share your {site.place} story</h1>
    <p class="lead">
      The best guidance here comes from people actually living it. Read
      what other nomads have found, then add your own: a favourite spot,
      a hard-won lesson, or how you made {site.place} home.
    </p>
    <a href="/community-submit/" class="btn">Submit your story</a>
  </div>

  <section class="wrap stories" aria-labelledby="stories-heading">
    <h2 id="stories-heading">Community stories</h2>

    {stories.length === 0 ? (
      <div class="empty">
        <p>
          No community stories yet. Yours could be the first: share
          your {site.place} and it will appear here, with credit to
          you.
        </p>
        <a href="/community-submit/" class="btn btn--ghost">
          Submit your story
        </a>
      </div>
    ) : (
      <div data-story-filter>
        {tags.length > 0 && (
          <div class="tags" role="group" aria-label="Filter stories by tag">
            <button type="button" class="tag" data-tag="" aria-pressed="true">
              All
            </button>
            {tags.map((tag) => (
              <button type="button" class="tag" data-tag={tag} aria-pressed="false">
                {tag}
              </button>
            ))}
          </div>
        )}

        <p class="sr-only" aria-live="polite" data-status></p>

        <ul class="card-grid">
          {stories.map((story) => (
            <li data-tags={JSON.stringify(story.data.tags)}>
              <Card
                href={`/community/${story.id}/`}
                title={story.data.title}
                description={story.data.description}
                tag={story.data.tags[0]}
                byline={`By ${story.data.author}`}
                image={story.data.image}
                cta="Read story"
              />
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>
</BaseLayout>

<script>
  // Thank-you banner: shown only when the URL has ?submitted=1 (the
  // Tally form redirects here after a submission).
  const thanks = document.querySelector<HTMLElement>("[data-thanks]");
  const params = new URLSearchParams(location.search);
  if (thanks && params.get("submitted") === "1") {
    thanks.hidden = false;
    thanks.querySelector("[data-thanks-close]")?.addEventListener("click", () => {
      thanks.hidden = true;
      // Drop the parameter so a refresh doesn't bring the banner back.
      params.delete("submitted");
      const query = params.toString();
      history.replaceState(null, "", location.pathname + (query ? `?${query}` : "") + location.hash);
    });
  }

  // Tag filter.
  const root = document.querySelector<HTMLElement>("[data-story-filter]");
  if (root) {
    const buttons = root.querySelectorAll<HTMLButtonElement>("button[data-tag]");
    const items = root.querySelectorAll<HTMLElement>("li[data-tags]");
    const status = root.querySelector<HTMLElement>("[data-status]")!;

    const filter = (tag: string) => {
      let shown = 0;
      items.forEach((item) => {
        const tags: string[] = JSON.parse(item.dataset.tags ?? "[]");
        const match = !tag || tags.includes(tag);
        item.hidden = !match;
        if (match) shown++;
      });
      buttons.forEach((b) =>
        b.setAttribute("aria-pressed", String(b.dataset.tag === tag))
      );
      const noun = shown === 1 ? "story" : "stories";
      status.textContent = tag
        ? `Showing ${shown} ${noun} tagged ${tag}`
        : `Showing ${shown} ${noun}`;
    };

    buttons.forEach((b) =>
      b.addEventListener("click", () => filter(b.dataset.tag ?? ""))
    );
  }
</script>

<style>
  .thanks {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
    padding: 1rem 1rem 1rem 1.5rem;
    background: color-mix(in srgb, var(--accent) 12%, var(--paper-raised));
    border: 1px solid color-mix(in srgb, var(--accent) 40%, var(--mist));
    border-left: 4px solid var(--accent);
    border-radius: var(--radius);
  }
  .thanks[hidden] {
    display: none;
  }
  .thanks p {
    flex: 1;
    margin: 0;
    padding-top: 0.15rem;
    color: var(--ink);
    font-weight: 500;
  }
  .thanks-close {
    flex: none;
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: var(--ink-soft);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }
  .thanks-close:hover {
    background: color-mix(in srgb, var(--accent) 20%, transparent);
    color: var(--ink);
  }
  .thanks-close:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .page-head {
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
  }
  .page-head h1 {
    font-size: clamp(1.9rem, 1.4rem + 2vw, 2.8rem);
    max-width: 24ch;
  }
  .lead {
    font-size: 1.15rem;
    color: var(--ink-soft);
    max-width: 56ch;
    margin-bottom: 1.6rem;
  }
  .stories {
    margin-top: var(--space-section);
    padding-top: clamp(2.5rem, 6vw, 4rem);
    border-top: 1px solid var(--mist);
  }
  .stories h2 {
    margin-bottom: 1.2rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 2rem;
  }
  .tag {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 500;
    padding: 0.35rem 1rem;
    border: 1.5px solid var(--mist-deep);
    border-radius: 999px;
    background: var(--paper-raised);
    color: var(--ink-soft);
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
  }
  .tag:hover {
    border-color: var(--brand);
    color: var(--brand);
  }
  .tag:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .tag[aria-pressed="true"] {
    background: var(--brand);
    border-color: var(--brand);
    color: var(--paper-raised);
  }
  .card-grid > li[hidden] {
    display: none;
  }
  .empty {
    background: var(--paper-raised);
    border: 1px solid var(--mist);
    border-radius: var(--radius);
    padding: 1.5rem 1.7rem;
    max-width: 40rem;
  }
  .empty p {
    margin-top: 0;
    color: var(--ink-soft);
  }
</style>
