---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Faq from "../components/Faq.astro";
import RelatedPosts from "../components/RelatedPosts.astro";
import { site } from "../site.config.ts";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;

const dateStr = d.pubDate.toLocaleDateString(site.language, {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: d.title,
  description: d.description,
  datePublished: d.pubDate.toISOString(),
  dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
  inLanguage: site.language,
  author: { "@type": "Organization", name: site.name },
  publisher: { "@type": "Organization", name: site.name },
  mainEntityOfPage: new URL(`/${post.id}/`, site.url).href,
  ...(d.image && { image: new URL(d.image, site.url).href }),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: site.url },
    {
      "@type": "ListItem",
      position: 2,
      name: "Guides",
      item: new URL("/blog/", site.url).href,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: d.title,
      item: new URL(`/${post.id}/`, site.url).href,
    },
  ],
};
---

<BaseLayout
  title={d.title}
  description={d.description}
  path={`/${post.id}/`}
  image={d.image}
  type="article"
  publishedDate={d.pubDate}
  updatedDate={d.updatedDate}
  schema={[articleSchema, breadcrumbSchema]}
>
  <article class="wrap post">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/blog/">Guides</a>
    </nav>

    <header class="post-header">
      <h1>{d.title}</h1>
      <p class="post-meta">
        <time datetime={d.pubDate.toISOString()}>{dateStr}</time>
        {d.updatedDate && (
          <span>
            · updated {d.updatedDate.toLocaleDateString(site.language, {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
          </span>
        )}
      </p>
    </header>

    {d.image && (
      <img
        class="post-cover"
        src={d.image}
        alt={d.imageAlt ?? d.title}
        width="1200"
        height="630"
        loading="eager"
      />
    )}

    {d.keyAnswer && (
      <aside class="key-answer" aria-label="Quick answer">
        <h2>The short answer</h2>
        <p>{d.keyAnswer}</p>
      </aside>
    )}

    <div class="prose post-body">
      <Content />
    </div>

    <Faq items={d.faqs} />

    <footer class="post-foot">
      <a href="/blog/" class="btn btn--ghost">← More guides</a>
    </footer>
  </article>

  <RelatedPosts currentId={post.id} tags={d.tags} />
</BaseLayout>

<style>
  .post {
    padding-top: clamp(1.5rem, 4vw, 3rem);
    max-width: 48rem;
  }
  .crumbs {
    display: flex;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
    margin-bottom: 1.2rem;
  }
  .crumbs a {
    color: var(--ink-soft);
  }
  .crumbs a:hover {
    color: var(--brand);
  }
  .post-header h1 {
    margin-bottom: 0.4rem;
  }
  .post-meta {
    color: var(--ink-soft);
    font-size: 0.95rem;
    margin: 0;
  }
  .post-cover {
    width: 100%;
    border-radius: var(--radius);
    margin: 1.8rem 0;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
  }
  .key-answer {
    background: color-mix(in srgb, var(--accent) 12%, var(--paper-raised));
    border: 1px solid color-mix(in srgb, var(--accent) 40%, var(--mist));
    border-radius: var(--radius);
    padding: 1.3rem 1.5rem;
    margin: 1.8rem 0;
  }
  .key-answer h2 {
    font-size: 1.1rem;
    margin: 0 0 0.4rem;
  }
  .key-answer p {
    margin: 0;
    color: var(--ink);
  }
  .post-body {
    margin-top: 1.5rem;
  }
  .post-foot {
    margin-top: var(--space-section);
    padding-top: 1.5rem;
    border-top: 1px solid var(--mist);
  }
</style>
