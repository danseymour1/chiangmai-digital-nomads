---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../site.config.ts";

const link = site.forms.contactFormLink;

const isTally = link.includes("tally.so");
const tallyEmbed = isTally
  ? link.replace("tally.so/r/", "tally.so/embed/") +
    (link.includes("?") ? "&" : "?") +
    "alignLeft=1&transparentBackground=1&dynamicHeight=1"
  : "";

const description = `Get in touch with ${site.name} — questions, corrections, or just to say hello.`;
---

<BaseLayout title="Contact" description={description} path="/contact">
  <div class="wrap page">
    <h1>Get in touch</h1>
    <p class="lead">
      Questions about {site.place}, a correction, or a partnership idea?
      Send a message and we'll get back to you.
    </p>

    {link ? (
      isTally ? (
        <div class="embed">
          <iframe
            data-tally-src={tallyEmbed}
            src={tallyEmbed}
            width="100%"
            height="600"
            frameborder="0"
            title="Contact form"
            loading="lazy"
          ></iframe>
        </div>
      ) : (
        <p class="cta">
          <a href={link} class="btn" target="_blank" rel="noopener">
            Open the contact form
          </a>
        </p>
      )
    ) : (
      <p class="email">
        Email <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    )}
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
    max-width: 42rem;
  }
  .lead {
    font-size: 1.15rem;
    color: var(--ink-soft);
    max-width: 52ch;
    margin-bottom: 2rem;
  }
  .embed {
    border: 1px solid var(--mist);
    border-radius: var(--radius);
    padding: 0.5rem;
    background: var(--paper-raised);
  }
  .embed iframe {
    display: block;
    width: 100%;
    border: none;
  }
  .cta {
    margin-top: 1rem;
  }
  .email {
    font-size: 1.15rem;
  }
</style>
