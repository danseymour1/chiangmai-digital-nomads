---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../site.config.ts";

const description = `Who's behind ${site.name} and why it exists: an honest, independent guide to remote life in ${site.place}, Thailand.`;
---

<BaseLayout title="About" description={description} path="/about">
  <div class="wrap page">
    <h1>About {site.name}</h1>
    <div class="prose">
      <p>
        {site.name} is a small, independent guide for remote workers
        who are curious about {site.place}, the laid-back, creative
        hub of northern Thailand and one of the most popular bases for
        digital nomads anywhere.
      </p>

      <h2>It's a community</h2>
      <p>
        The best tips don't come from a single writer. They come from
        the people living here. Anyone with a story, a hard-won lesson
        or a favourite spot is welcome to
        <a href="/community-submit/">share it</a>, and it will be turned
        into a community story, with credit to them.
      </p>

      <h2>Why this site exists</h2>
      <p>
        Most of what you find online about moving here is either years
        out of date or written by someone who spent a long weekend and
        called it research. This site sets out to show what it's
        actually like: what things cost this year, which cafés have
        reliable wifi, how the visa runs really work, and where to find
        other people doing the same thing.
      </p>
      <p>
        A community of nomads sharing their own experiences makes that
        guidance better, kept up to date by the people living in the city.
      </p>

      <p>
        Questions, corrections or just want to say hello?
        <a href="/contact">Get in touch</a>.
      </p>
    </div>

    <p class="credit">
      Created by Dan from <a
        href="https://danroundtheworld.com/why-i-moved-to-chiang-mai-as-a-digital-nomad/"
        target="_blank"
        rel="noopener">Dan Round the World</a>, a full-time digital nomad of over five years who now lives in Chiang Mai.
    </p>
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
    max-width: 48rem;
  }
  .credit {
    max-width: var(--measure);
    margin-top: 3rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--mist);
    font-size: 0.88rem;
    color: var(--ink-soft);
  }
  .credit a {
    color: var(--ink-soft);
  }
  .credit a:hover {
    color: var(--brand);
  }
</style>
