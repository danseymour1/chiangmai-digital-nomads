---
import { getCollection } from "astro:content";

interface Props {
  currentId: string;
  tags?: string[];
}
const { currentId, tags = [] } = Astro.props;

/* Up to 3 other posts: those sharing the most tags first, then
   topped up with the most recent. Hidden if fewer than 2. */
const MAX = 3;
const MIN = 2;

const others = (
  await getCollection("posts", ({ id, data }) => !data.draft && id !== currentId)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const shared = (post: (typeof others)[number]) =>
  post.data.tags.filter((t) => tags.includes(t)).length;

const tagged = others
  .filter((p) => shared(p) > 0)
  .sort((a, b) => shared(b) - shared(a));
const recent = others.filter((p) => shared(p) === 0);
const related = [...tagged, ...recent].slice(0, MAX);
---

{related.length >= MIN && (
  <section class="related" aria-labelledby="related-heading">
    <div class="wrap">
      <h2 id="related-heading">You might also like</h2>
      <ul class="related-grid">
        {related.map((post) => (
          <li>
            <a href={`/${post.id}/`} class="related-card">
              {post.data.image && (
                <img
                  class="related-thumb"
                  src={post.data.image}
                  alt=""
                  width="1200"
                  height="630"
                  loading="lazy"
                  decoding="async"
                />
              )}
              <div class="related-body">
                {post.data.tags.length > 0 && (
                  <span class="related-tag">{post.data.tags[0]}</span>
                )}
                <h3>{post.data.title}</h3>
                <p class="related-desc">{post.data.description}</p>
                <span class="related-read">Read guide</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .related {
    margin-top: var(--space-section);
    padding-top: clamp(2.5rem, 6vw, 4rem);
    border-top: 1px solid var(--mist);
  }
  .related h2 {
    margin-bottom: 1.5rem;
  }
  .related-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap);
  }
  @media (min-width: 640px) {
    .related-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 960px) {
    .related-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .related-grid li {
    display: flex;
  }
  .related-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    overflow: hidden;
    background: var(--paper-raised);
    border: 1px solid var(--mist);
    border-top: 3px solid var(--brand);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .related-card:hover {
    border-color: var(--mist-deep);
    border-top-color: var(--accent);
    transform: translateY(-2px);
  }
  .related-card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .related-thumb {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
  }
  .related-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.3rem 1.4rem 1.4rem;
  }
  .related-tag {
    align-self: flex-start;
    margin-bottom: 0.8rem;
    padding: 0.1rem 0.6rem;
    border: 1px solid var(--mist-deep);
    border-radius: 999px;
    font-size: 0.82rem;
    color: var(--ink-soft);
  }
  .related-card h3 {
    font-size: 1.25rem;
    margin: 0 0 0.5rem;
    color: var(--ink);
    transition: color 0.15s ease;
  }
  .related-card:hover h3 {
    color: var(--brand);
  }
  .related-desc {
    margin: 0 0 1.2rem;
    font-size: 0.95rem;
    color: var(--ink-soft);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .related-read {
    margin-top: auto;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--brand);
  }
  .related-card:hover .related-read {
    color: var(--accent);
  }
</style>
