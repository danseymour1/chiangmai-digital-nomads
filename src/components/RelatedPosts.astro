---
import { getCollection } from "astro:content";
import Card from "./Card.astro";

interface Props {
  currentId: string;
  tags?: string[];
}
const { currentId, tags = [] } = Astro.props;

/* Up to 3 other posts: those sharing the most tags first, then
   topped up with the most recent. Hidden if fewer than 2. */
const MAX = 3;
const MIN = 2;

const others = (
  await getCollection("posts", ({ id, data }) => !data.draft && id !== currentId)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const shared = (post: (typeof others)[number]) =>
  post.data.tags.filter((t) => tags.includes(t)).length;

const tagged = others
  .filter((p) => shared(p) > 0)
  .sort((a, b) => shared(b) - shared(a));
const recent = others.filter((p) => shared(p) === 0);
const related = [...tagged, ...recent].slice(0, MAX);
---

{related.length >= MIN && (
  <section class="related" aria-labelledby="related-heading">
    <div class="wrap">
      <h2 id="related-heading">You might also like</h2>
      <ul class="card-grid">
        {related.map((post) => (
          <li>
            <Card
              href={`/${post.id}/`}
              title={post.data.title}
              description={post.data.description}
              tag={post.data.tags[0]}
              image={post.data.image}
            />
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .related {
    margin-top: var(--space-section);
    padding-top: clamp(2.5rem, 6vw, 4rem);
    border-top: 1px solid var(--mist);
  }
  .related h2 {
    margin-bottom: 1.5rem;
  }
</style>
