---
/* A linked card used in .card-grid layouts. Shows the image as a
   thumbnail on top only if one is given. */
interface Props {
  href: string;
  title: string;
  description: string;
  tag?: string;
  byline?: string;
  image?: string;
  cta?: string;
}
const {
  href,
  title,
  description,
  tag,
  byline,
  image,
  cta = "Read guide",
} = Astro.props;
---

<a href={href} class="card">
  {image && (
    <img
      class="card-thumb"
      src={image}
      alt=""
      width="1200"
      height="630"
      loading="lazy"
      decoding="async"
    />
  )}
  <div class="card-body">
    {tag && <span class="card-tag">{tag}</span>}
    <h3>{title}</h3>
    {byline && <p class="card-byline">{byline}</p>}
    <p class="card-desc">{description}</p>
    <span class="card-read">{cta}</span>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    width: 100%;
    overflow: hidden;
    background: var(--paper-raised);
    border: 1px solid var(--mist);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    color: inherit;
    text-decoration: none;
    transition: box-shadow 0.25s ease, transform 0.25s ease;
  }
  .card:hover {
    box-shadow: var(--shadow-lift);
    transform: translateY(-3px);
  }
  .card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .card-thumb {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
  }
  .card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.5rem 1.6rem 1.6rem;
  }
  .card-tag {
    align-self: flex-start;
    margin-bottom: 0.8rem;
    padding: 0.2rem 0.65rem;
    background: var(--paper-2);
    border-radius: var(--radius-pill);
    font-family: var(--font-label);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .card h3 {
    font-size: 1.2rem;
    letter-spacing: -0.018em;
    margin: 0 0 0.5rem;
    color: var(--ink);
    transition: color 0.15s ease;
  }
  .card:hover h3 {
    color: var(--brand);
  }
  .card-byline {
    margin: -0.2rem 0 0.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink-soft);
  }
  .card-desc {
    margin: 0 0 1.2rem;
    font-size: 0.95rem;
    color: var(--ink-soft);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-read {
    margin-top: auto;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--brand);
  }
  .card:hover .card-read {
    color: color-mix(in srgb, var(--brand) 70%, var(--ink));
  }
</style>
