---
import { site } from "../site.config.ts";
const year = new Date().getFullYear();
const socials = Object.entries(site.social).filter(([, v]) => v);
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <span class="footer-name">{site.name}</span>
      <p>{site.footerNote}</p>
      {socials.length > 0 && (
        <ul class="footer-social">
          {socials.map(([name, href]) => (
            <li>
              <a href={href} rel="me noopener" target="_blank">
                {name.charAt(0).toUpperCase() + name.slice(1)}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>

    <nav class="footer-nav" aria-label="Footer">
      <ul>
        {site.nav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="wrap footer-legal">
    <p>© {year} {site.name}. All rights reserved.</p>
  </div>
</footer>

<style>
  /* Coral: a restrained footer, a rule above and one line of content. */
  .site-footer {
    margin-top: var(--space-section);
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    position: relative;
    padding-top: 1.6rem;
    padding-bottom: 1rem;
  }
  .footer-inner::before {
    content: "";
    position: absolute;
    top: 0;
    left: clamp(1.1rem, 4vw, 2.5rem);
    right: clamp(1.1rem, 4vw, 2.5rem);
    border-top: 1px solid var(--mist-deep);
  }
  .footer-brand {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 0.9rem;
  }
  .footer-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.98rem;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .footer-brand p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--muted);
  }
  .footer-social {
    display: flex;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer-social a {
    font-size: 0.92rem;
    color: var(--ink-soft);
    font-weight: 500;
  }
  .footer-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
  }
  .footer-nav a {
    color: var(--ink-soft);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.92rem;
    white-space: nowrap;
  }
  .footer-nav a:hover {
    color: var(--ink);
  }
  .footer-legal {
    padding-bottom: 1.6rem;
  }
  .footer-legal p {
    margin: 0;
    font-family: var(--font-label);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: var(--muted);
  }
</style>
