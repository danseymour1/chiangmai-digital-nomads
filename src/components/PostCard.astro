---
import { site } from "../site.config.ts";
interface Props {
  title: string;
  description: string;
  slug: string;
  pubDate: Date;
  tags?: string[];
}
const { title, description, slug, pubDate, tags = [] } = Astro.props;
const dateStr = pubDate.toLocaleDateString(site.language, {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const isoDate = pubDate.toISOString();
---

<article class="post-card">
  <a href={`/${slug}/`} class="post-card-link">
    <h3>{title}</h3>
    <p class="post-card-desc">{description}</p>
    <p class="post-card-meta">
      <time datetime={isoDate}>{dateStr}</time>
      {tags.length > 0 && <span class="post-card-tag">{tags[0]}</span>}
      <span class="post-card-read">Read guide</span>
    </p>
  </a>
</article>

<style>
  /* Coral: refined white card surfaces with a subtle border. */
  .post-card {
    margin-bottom: 0.75rem;
    background: var(--paper-raised);
    border: 1px solid var(--mist);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .post-card:hover {
    border-color: var(--mist-deep);
    box-shadow: var(--shadow-lift);
  }
  .post-card-link {
    display: block;
    padding: clamp(1.2rem, 3vw, 1.6rem) clamp(1.2rem, 3vw, 1.8rem);
    text-decoration: none;
    color: inherit;
  }
  .post-card h3 {
    margin: 0 0 0.4rem;
    color: var(--ink);
  }
  .post-card-desc {
    margin: 0 0 0.7rem;
    color: var(--ink-soft);
    max-width: 62ch;
  }
  .post-card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin: 0;
    font-size: 0.92rem;
    color: var(--ink-soft);
  }
  .post-card-tag {
    padding: 0.15rem 0.6rem;
    background: var(--paper-2);
    border-radius: var(--radius-pill);
    font-family: var(--font-label);
    font-size: 0.74rem;
    letter-spacing: 0.05em;
  }
  .post-card-meta > * {
    white-space: nowrap;
  }
  .post-card-read {
    margin-left: auto;
    color: var(--ink);
    font-weight: 500;
  }
  .post-card-read::after {
    content: " →";
    color: var(--accent);
  }
</style>
