---
import { site } from "../site.config.ts";
interface Props {
  title: string;
  description: string;
  slug: string;
  pubDate: Date;
  tags?: string[];
}
const { title, description, slug, pubDate, tags = [] } = Astro.props;
const dateStr = pubDate.toLocaleDateString(site.language, {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const isoDate = pubDate.toISOString();
---

<article class="post-card">
  <a href={`/${slug}/`} class="post-card-link">
    <h3>{title}</h3>
    <p class="post-card-desc">{description}</p>
    <p class="post-card-meta">
      <time datetime={isoDate}>{dateStr}</time>
      {tags.length > 0 && <span class="post-card-tag">{tags[0]}</span>}
      <span class="post-card-read">Read guide</span>
    </p>
  </a>
</article>

<style>
  /* Bloom: each guide is an elevated card rather than a ruled row. */
  .post-card {
    margin-bottom: 1rem;
    background: var(--paper-raised);
    border: 1px solid var(--mist);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    transition: box-shadow 0.25s ease, transform 0.25s ease;
  }
  .post-card:hover {
    box-shadow: var(--shadow-lift);
    transform: translateY(-2px);
  }
  .post-card-link {
    display: block;
    padding: clamp(1.3rem, 3vw, 1.8rem) clamp(1.3rem, 3vw, 2rem);
    text-decoration: none;
    color: inherit;
  }
  .post-card h3 {
    margin: 0 0 0.4rem;
    color: var(--ink);
    transition: color 0.15s ease;
  }
  .post-card-link:hover h3 {
    color: var(--brand);
  }
  .post-card-desc {
    margin: 0 0 0.7rem;
    color: var(--ink-soft);
    max-width: 62ch;
  }
  .post-card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin: 0;
    font-size: 0.92rem;
    color: var(--ink-soft);
  }
  .post-card-tag {
    padding: 0.2rem 0.65rem;
    background: var(--paper-2);
    border-radius: var(--radius-pill);
    font-family: var(--font-label);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .post-card-meta > * {
    white-space: nowrap;
  }
  .post-card-read {
    margin-left: auto;
    color: var(--brand);
    font-weight: 600;
  }
  .post-card-link:hover .post-card-read {
    color: color-mix(in srgb, var(--brand) 70%, var(--ink));
  }
</style>
